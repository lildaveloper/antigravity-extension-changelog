{
  "name": "google-antigravity",
  "displayName": "Google Antigravity",
  "description": "Bring Google's agent-first development platform to Visual Studio Code.",
  "icon": "img/logo.png",
  "version": "1.2.0",
  "publisher": "google",
  "license": "SEE LICENSE IN LICENSE.txt",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "AI",
    "Agent",
    "Antigravity",
    "Gemini",
    "Coding Assistant",
    "Autonomous Agent",
    "MCP",
    "Model Context Protocol",
    "Google Cloud",
    "AGY"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCustomEditor:antigravity.artifactEditor"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "antigravity.artifactEditor",
        "displayName": "Antigravity Artifact Viewer",
        "selector": [
          {
            "filenamePattern": "antigravity:/**/*.md"
          },
          {
            "filenamePattern": "**/.gemini/*/brain/**/*.md"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "jetski.settingsEditor",
        "displayName": "Antigravity Settings Viewer",
        "selector": [
          {
            "filenamePattern": "jetski-settings://**"
          }
        ],
        "priority": "default"
      }
    ],
    "views": {
      "antigravity-sidebar": [
        {
          "type": "webview",
          "id": "antigravity.panel",
          "name": "Antigravity",
          "icon": "img/logo.svg"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-sidebar",
          "title": "Antigravity",
          "icon": "img/logo.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravity.showThirdPartyNotices",
        "title": "Show Third Party Notices",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.resetConversationState",
        "title": "Reset Conversation State",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.insertSnippet",
        "title": "Add Selection to Chat",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.panel.focus",
        "title": "Focus Antigravity Panel",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.inlineDiff.acceptAll",
        "title": "Accept All Changes",
        "icon": "$(check)",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.inlineDiff.rejectAll",
        "title": "Reject All Changes",
        "icon": "$(close)",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.toggleInlineDiff",
        "title": "Toggle Inline Diff",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.openSettings",
        "title": "Open Antigravity Settings",
        "category": "Antigravity"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "antigravity.inlineDiff.acceptAll",
          "when": "antigravity.hasActiveDiff"
        },
        {
          "command": "antigravity.inlineDiff.rejectAll",
          "when": "antigravity.hasActiveDiff"
        }
      ],
      "editor/title": [
        {
          "command": "antigravity.inlineDiff.acceptAll",
          "group": "navigation",
          "when": "resourceScheme == file && antigravity.hasActiveDiff"
        },
        {
          "command": "antigravity.inlineDiff.rejectAll",
          "group": "navigation",
          "when": "resourceScheme == file && antigravity.hasActiveDiff"
        }
      ]
    },
    "keybindings": [
      {
        "command": "antigravity.insertSnippet",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      },
      {
        "command": "antigravity.insertTerminalSnippet",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "terminalFocus && isMac"
      },
      {
        "command": "antigravity.toggleChatFocus",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "!editorTextFocus && !terminalFocus && !antigravity.chatFocused",
        "args": "focus"
      },
      {
        "command": "antigravity.toggleChatFocus",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "antigravity.chatFocused",
        "args": "close"
      },
      {
        "command": "antigravity.startNewConversation",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      },
      {
        "command": "antigravity.dynamic.acceptAgentStep",
        "key": "alt+enter",
        "mac": "alt+enter",
        "when": "antigravity.stepPending"
      },
      {
        "command": "antigravity.dynamic.rejectAgentStep",
        "key": "alt+shift+enter",
        "mac": "alt+shift+enter",
        "when": "antigravity.stepPending"
      },
      {
        "command": "antigravity.dynamic.interruptAgent",
        "key": "escape",
        "mac": "escape",
        "when": "antigravity.agentRunning && focusedView == 'antigravity.panel'"
      }
    ],
    "configuration": {
      "title": "Antigravity",
      "properties": {
        "antigravity.serverPort": {
          "type": "number",
          "default": 0,
          "description": "Port for the Antigravity background server (`agy --hub`). Leave at 0 to allocate an ephemeral port automatically."
        },
        "antigravity.enableTelemetry": {
          "type": "boolean",
          "default": true,
          "description": "Enable sending client-side product telemetry and usage metrics to Google Cloudmill to help improve Antigravity."
        },
        "antigravity.enableInlineDiff": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline diff decorations and CodeLenses. When disabled, falls back to opening changes in a side-by-side diff tab."
        },
        "antigravity.autoOpenFiles": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open files in the editor when the agent proposes edits."
        },
        "antigravity.channel": {
          "type": "string",
          "default": "production",
          "description": "The release channel for this extension build",
          "deprecationMessage": "Internal channel setting"
        }
      }
    }
  },
  "buildInfo": {
    "BUILD_CLIENT": "(SrcFS)",
    "BUILD_CLIENT_MINT_STATUS": "1",
    "BUILD_DEPOT_PATH": "//depot/google3",
    "BUILD_DIRECTORY": "/google/src/cloud/buildrabbit-username/buildrabbit-client/google3",
    "BUILD_USERNAME": "kokoro-dedicated",
    "BUILD_BLAZE_RELEASE": "release blaze-2026.08.18-1 (mainline @965897722)",
    "BUILD_EMBED_LABEL": "antigravity_vscode_extension_1.2.0_RC00",
    "BUILD_HOSTNAME": "lmbgv8.prod.google.com",
    "VERIFIABLE": "0",
    "WORKSPACE_STATUS_COMMAND_ARGUMENT": "<precomputed>"
  }
}
